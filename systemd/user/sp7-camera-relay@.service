[Unit]
Description=SP7 camera idle relay (%i)

[Service]
Type=simple

EnvironmentFile=/usr/local/share/sp7-camera/%i.env

ExecStartPre=/usr/bin/test -e ${DEVICE}
ExecStartPre=/usr/bin/rm -f %t/sp7-camera-%i.fifo
ExecStartPre=/usr/bin/mkfifo %t/sp7-camera-%i.fifo

ExecStart=/usr/local/libexec/sp7-camera-relay \
    ${DEVICE} \
    %t/sp7-camera-%i.fifo \
    ${WIDTH} \
    ${HEIGHT} \
    ${FPS_NUM} \
    ${FPS_DEN}

Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
