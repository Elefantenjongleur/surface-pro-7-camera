#!/usr/bin/env bash

# Surface Pro 7 / Realtek ALC274
#
# WirePlumber/ACP initialisiert die ALSA-Karte asynchron.
# Deshalb reicht systemd "After=wireplumber.service" allein nicht:
# Der WirePlumber-Prozess kann bereits laufen, während die Audioquelle
# und die ALSA-Mixerpfade noch eingerichtet werden.
#
# Wir warten daher auf die echte interne PipeWire-Aufnahmequelle und
# setzen Internal Mic Boost erst danach auf den bekannten guten Wert.

CARD="PCH"
CONTROL="Internal Mic Boost"
PLAYBACK_CONTROL="Master"
SOURCE="alsa_input.pci-0000_00_1f.3.analog-stereo"

if ! command -v amixer >/dev/null 2>&1; then
    exit 0
fi

if ! command -v wpctl >/dev/null 2>&1; then
    exit 0
fi

# Maximal etwa 30 Sekunden auf die von WirePlumber erzeugte
# interne Audioquelle warten.
SOURCE_READY=0

for i in {1..60}; do
    if wpctl status -n 2>/dev/null |
       grep -Fq "$SOURCE"; then
        SOURCE_READY=1
        break
    fi

    sleep 0.5
done

# Falls PipeWire/WirePlumber die Quelle nicht erzeugt hat, den Fix
# trotzdem versuchen. Das Verhalten bleibt damit fehlertolerant.
if ! amixer -c "$CARD" scontrols 2>/dev/null |
     grep -Fq "Simple mixer control '$CONTROL',0"; then
    exit 0
fi

# ACP nach Erscheinen der Quelle noch kurz seine Initialisierung
# abschließen lassen.
if [[ "$SOURCE_READY" -eq 1 ]]; then
    sleep 2
fi

# Hardware-Mikrofonboost abschalten.
amixer -q -c "$CARD" set "$CONTROL" 0

# Bei aktiviertem WirePlumber-Soft-Mixer wird der ALSA-Hardware-Master
# nicht mehr von der normalen PipeWire/GNOME-Lautstärke nachgeführt.
# Deshalb den bekannten guten Wiedergabewert explizit herstellen:
# Master = 100 % / 0 dB / unmuted.
if amixer -c "$CARD" scontrols 2>/dev/null |
   grep -Fq "Simple mixer control '$PLAYBACK_CONTROL',0"; then
    amixer -q -c "$CARD" set "$PLAYBACK_CONTROL" 100% unmute
fi
