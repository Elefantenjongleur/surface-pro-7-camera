+
+/* OV5693 programs mode registers on runtime resume, not ACTIVE set_fmt.
+ * Wait only for the Standard node: before configuring a different mode and
+ * after stopping it, so the next profile can start from a suspended sensor.
+ * This reads power state; it never changes the kernel's PM configuration. */
+int sp7_front_wait_sensor_suspend(struct impl *impl)
+{
+	if (!impl->sp7FrontStandardProfile)
+		return 0;
+
+	const auto deadline = std::chrono::steady_clock::now() +
+		std::chrono::milliseconds(1500);
+	bool waited = false;
+	do {
+		std::ifstream status("/sys/bus/i2c/devices/i2c-INT33BE:00/power/runtime_status");
+		std::string state;
+		if (!(status >> state)) {
+			spa_log_error(impl->log, "SP7 Front Standard: cannot read sensor runtime state");
+			return -EIO;
+		}
+		if (state == "suspended") {
+			if (waited)
+				spa_log_info(impl->log, "SP7 Front Standard: sensor suspended before mode transition");
+			return 0;
+		}
+		waited = true;
+		std::this_thread::sleep_for(std::chrono::milliseconds(20));
+	} while (std::chrono::steady_clock::now() < deadline);
+
+	spa_log_warn(impl->log, "SP7 Front Standard: sensor did not suspend within 1500 ms");
+	return -EBUSY;
+}
 
