+		: nullptr;
+
+	/*
+	 * Prefer the profile transported through api.libcamera.path.
+	 * Keep the custom property as a fallback.
+	 */
+	std::string sp7ProfileStorage =
+		!sp7ProfileFromPath.empty()
+			? sp7ProfileFromPath
+			: (sp7ProfileProp ? sp7ProfileProp : "");
+
+	const char *sp7Profile =
+		sp7ProfileStorage.empty()
+			? nullptr
+			: sp7ProfileStorage.c_str();
+
+	if (sp7Profile) {
+		libcamera::SensorConfiguration sensorConfig;
+		sensorConfig.bitDepth = 10;
+
+		if (spa_streq(sp7Profile, "smooth")) {
+			sensorConfig.outputSize = libcamera::Size(1632, 1224);
+			config->sensorConfig = sensorConfig;
+
+			spa_log_info(log,
+				     "SP7 profile smooth: sensor 1632x1224");
+		} else if (spa_streq(sp7Profile, "hq")) {
+			sensorConfig.outputSize = libcamera::Size(3264, 2448);
+			config->sensorConfig = sensorConfig;
+
+			spa_log_info(log,
+				     "SP7 profile %s: sensor 3264x2448",
+				     sp7Profile);
+		} else if (spa_streq(sp7Profile, "fast")) {
+			sensorConfig.outputSize = libcamera::Size(1632, 918);
+			config->sensorConfig = sensorConfig;
+
+			spa_log_info(log,
+				     "SP7 profile %s: sensor 1632x918 full-FOV test",
+				     sp7Profile);
+		}
+	}
+
+	auto *instance = new (handle) impl(log, data_loop, system,
+					 std::move(manager), std::move(camera),
+					 std::move(config));
+
+	instance->sp7HqProfile =
+		sp7Profile && spa_streq(sp7Profile, "hq");
+
+	spa_log_info(log, "SP7 source profile: %s%s",
+		     sp7Profile ? sp7Profile : "none",
+		     instance->sp7HqProfile ? " [HQ native output]" : "");
 
 	return 0;
 }
