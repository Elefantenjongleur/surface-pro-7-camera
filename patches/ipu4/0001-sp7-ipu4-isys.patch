+/*
+ * SP7 full firmware recycle experiment.
+ *
+ * WirePlumber may keep V4L2 file handles open indefinitely.  Therefore the
+ * normal last-close / first-open firmware lifecycle is not repeated between
+ * captures.  At a point where no firmware stream is open, reproduce that
+ * lifecycle explicitly while preserving the userspace file handles:
+ *
+ *   firmware close
+ *   -> real ISYS parent power cycle
+ *   -> firmware authentication
+ *   -> SPC / message-buffer setup
+ *   -> firmware init
+ *
+ * The existing ipu_isys_force_power_cycle() performs the actual
+ * d0i0 -> i3 -> d0i0 transition and causes the normal ISYS runtime-resume
+ * callback (including isys_setup_hw()) to run.
+ */
+static int sp7_full_fw_recycle(struct ipu_isys *isys)
+{
+	struct ipu_bus_device *adev = to_ipu_bus_device(&isys->adev->dev);
+	struct ipu_device *isp = adev->isp;
+	unsigned long flags;
+	bool no_streams;
+	int close_rval = 0;
+	int rval;
+	int retries = 3;
+
+	spin_lock_irqsave(&isys->lock, flags);
+	no_streams = isys->stream_opened == 0;
+	spin_unlock_irqrestore(&isys->lock, flags);
+
+	if (!no_streams)
+		return -EBUSY;
+
+	mutex_lock(&isys->mutex);
+
+	if (!isys->video_opened) {
+		mutex_unlock(&isys->mutex);
+		return -ENODEV;
+	}
+
+	dev_info(&isys->adev->dev,
+		 "SP7 full recycle: begin, video_opened=%u\n",
+		 isys->video_opened);
+
+	/*
+	 * If an earlier firmware lifecycle operation already requested a reset,
+	 * do not try to talk to that context again.  Otherwise close it exactly
+	 * as video_release() does on the normal last-close path.
+	 */
+	if (!isys->reset_needed) {
+		close_rval = ipu_fw_isys_close(isys);
+		if (close_rval)
+			dev_warn(&isys->adev->dev,
+				 "SP7 full recycle: FW close returned %d; power cycling anyway\n",
+				 close_rval);
+	} else {
+		dev_warn(&isys->adev->dev,
+			 "SP7 full recycle: reset already required; skipping FW close\n");
+	}
+
+	/*
+	 * Deliberately request the existing recovery power cycle even after a
+	 * clean FW close.  This experiment specifically tests whether the real
+	 * ISYS power transition cures the source-3 restart transient.
+	 */
+	isys->reset_needed = true;
+	mutex_unlock(&isys->mutex);
+
+	rval = ipu_isys_force_power_cycle(isys);
+	if (rval) {
+		dev_err(&isys->adev->dev,
+			"SP7 full recycle: power cycle failed: %d\n", rval);
+		return rval;
+	}
+
+	/*
+	 * Match video_open(): authenticate the firmware again after the real
+	 * power transition before rebuilding the ISYS firmware context.
+	 */
+	do {
+		rval = ipu_buttress_authenticate(isp);
+		if (!rval)
+			break;
+
+		dev_warn(&isys->adev->dev,
+			 "SP7 full recycle: FW authentication failed, retrying (%d attempts left)\n",
+			 retries);
+		usleep_range(1000, 2000);
+	} while (retries-- > 0);
+
+	if (rval) {
+		mutex_lock(&isys->mutex);
+		isys->reset_needed = true;
+		mutex_unlock(&isys->mutex);
+
+		dev_err(&isys->adev->dev,
+			"SP7 full recycle: FW authentication failed: %d\n",
+			rval);
+		return rval;
+	}
+
+	mutex_lock(&isys->mutex);
+
+	ipu_configure_spc(isp,
+			  &isys->pdata->ipdata->hw_variant,
+			  IPU_CPD_PKG_DIR_ISYS_SERVER_IDX,
+			  isys->pdata->base, isys->pkg_dir,
+			  isys->pkg_dir_dma_addr);
+
+	ipu_cleanup_fw_msg_bufs(isys);
+
+	/*
+	 * A successful ipu_fw_isys_close() already cleared fwcom.  If close
+	 * timed out, the power cycle made the old hardware context irrelevant;
+	 * discard the remaining software context exactly as video_open() does
+	 * after recovery.
+	 */
+	if (isys->fwcom) {
+		dev_warn(&isys->adev->dev,
+			 "SP7 full recycle: cleaning stale FW context after power cycle\n");
+		ipu_fw_isys_cleanup(isys);
+	}
+
+	rval = ipu_fw_isys_init(isys, num_stream_support);
+	if (rval < 0) {
+		isys->reset_needed = true;
+		mutex_unlock(&isys->mutex);
+
+		dev_err(&isys->adev->dev,
+			"SP7 full recycle: FW re-init failed: %d\n",
+			rval);
+		return rval;
+	}
+
+	mutex_unlock(&isys->mutex);
+
+	dev_info(&isys->adev->dev,
+		 "SP7 full recycle: FW context rebuilt successfully\n");
+
+	return 0;
+}
